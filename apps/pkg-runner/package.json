{
  "name": "pkg-runner",
  "description": "A CLI tool to run npm/yarn scripts with an interactive prompt to select which script(s) to run.",
  "version": "1.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/core": "^1.1.0",
    "@clack/prompts": "^1.1.0",
    "ansi-colors": "^4.1.3",
    "es-toolkit": "^1.45.1",
    "fs-extra": "^11.3.4",
    "memoizee": "^0.4.17"
  },
  "keywords": [
    "npm",
    "package",
    "json",
    "script",
    "yarn",
    "yarn run",
    "npm run",
    "workspace",
    "node",
    "package manager",
    "run",
    "cli",
    "exec",
    "tool"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "npmPublish": "cd dist && npm publish"
  },
  "preferGlobal": true,
  "devDependencies": {
    "@mono/node": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "@types/memoizee": "^0.4.12"
  }
}
