{
  "name": "linkedin-resume",
  "description": "A CLI tool to generate a LinkedIn resume in PDF, HTML, and Markdown formats.",
  "version": "1.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "main": "dist/cli.mjs",
  "bin": "dist/cli.mjs",
  "license": "MIT",
  "keywords": [
    "linkedin",
    "resume",
    "cv",
    "pdf",
    "cli",
    "scraper",
    "puppeteer"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/cli.mjs",
    "dist/linkedin-resume.cjs",
    "resume.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bemoje/mono.git",
    "directory": "apps/linkedin-resume"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "build:attw": "yarn attw --pack dist",
    "npmPublish": "yarn build && yarn build:publint && yarn build:attw && cd dist && npm publish && cd ../../"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.4",
    "puppeteer": "^24.38.0",
    "upath": "^2.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@mono/config": "workspace:^",
    "@mono/node": "workspace:^",
    "@mono/object": "workspace:^",
    "@mono/os": "workspace:^",
    "@mono/stacktrace": "workspace:^",
    "@mono/types": "workspace:^",
    "@types/fs-extra": "^11.0.4"
  }
}
