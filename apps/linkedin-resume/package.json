{
  "name": "linkedin-resume",
  "description": "A CLI tool to generate a LinkedIn resume in PDF, HTML, and Markdown formats.",
  "version": "1.0.1",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "preferGlobal": true,
  "keywords": [
    "linkedin",
    "resume",
    "cv",
    "pdf",
    "cli",
    "scraper",
    "puppeteer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "npmPublish": "cd dist && npm publish"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "ansi-colors": "^4.1.3",
    "commander": "^14.0.3",
    "es-toolkit": "^1.45.1",
    "esbuild": "^0.25.12",
    "fs-extra": "^11.3.4",
    "puppeteer": "^24.38.0",
    "upath": "^2.0.1"
  },
  "devDependencies": {
    "@mono/config": "workspace:^",
    "@mono/node": "workspace:^",
    "@mono/object": "workspace:^",
    "@mono/os": "workspace:^",
    "@mono/stacktrace": "workspace:^",
    "@mono/types": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.1",
    "typescript": "^5.5.4"
  }
}
