{
  "name": "@mono/crypto",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "description": "Encryption, decryption, and string hashing utilities built on Node.js crypto.",
  "keywords": [
    "crypto",
    "encryption",
    "decryption",
    "hashing",
    "hash",
    "aes",
    "security",
    "node",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "yarn build && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./TCryptoAlgorithm": "./src/TCryptoAlgorithm.ts",
    "./decrypt": "./src/decrypt.ts",
    "./encrypt": "./src/encrypt.ts",
    "./strHashToBuffer": "./src/strHashToBuffer.ts",
    "./strHashToString": "./src/strHashToString.ts",
    "./strHashToStringDJB2": "./src/strHashToStringDJB2.ts",
    "./strHashToUint32Array": "./src/strHashToUint32Array.ts"
  }
}
