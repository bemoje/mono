{
  "name": "@mono/terminal",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "Terminal utilities for interactive prompts and display management.",
  "keywords": [
    "terminal",
    "interactive",
    "prompts",
    "display",
    "node",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "format-ws": "yarn prettier './*' 'src/**/*' --config '../../.prettierrc' --write --cache --list-different --ignore-unknown",
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && yarn build:publint && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsup": "^8.5.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./clearTerminal": "./src/clearTerminal.ts",
    "./confirmPrompt": "./src/confirmPrompt.ts"
  }
}
