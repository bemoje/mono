{
  "name": "@mono/terminal",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "Terminal utilities for interactive prompts and display management.",
  "keywords": [
    "terminal",
    "interactive",
    "prompts",
    "display",
    "node",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "yarn build && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./clearTerminal": "./src/clearTerminal.ts",
    "./confirmPrompt": "./src/confirmPrompt.ts"
  }
}
