{
  "name": "@mono/tschema",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "description": "TypeScript schema validation utilities based on TypeBox.",
  "keywords": [
    "typebox",
    "schema",
    "validation",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "format-ws": "yarn prettier './*' 'src/**/*' --config '../../.prettierrc' --write --cache --list-different --ignore-unknown",
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && yarn build:publint && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48"
  },
  "exports": {
    ".": "./src/index.ts",
    "./SchemaValidationError": "./src/SchemaValidationError.ts",
    "./assertValidSchema": "./src/assertValidSchema.ts"
  }
}
