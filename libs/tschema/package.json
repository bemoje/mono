{
  "name": "@mono/tschema",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "description": "TypeScript schema validation utilities based on TypeBox.",
  "keywords": [
    "typebox",
    "schema",
    "validation",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "yarn build && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48"
  },
  "exports": {
    ".": "./src/index.ts",
    "./SchemaValidationError": "./src/SchemaValidationError.ts",
    "./assertValidSchema": "./src/assertValidSchema.ts"
  }
}
