{
  "name": "@mono/types",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "description": "Advanced TypeScript type definitions and type-level utilities.",
  "keywords": [
    "types",
    "type-definitions",
    "type-level",
    "generics",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "format-ws": "yarn prettier './*' 'src/**/*' --config '../../.prettierrc' --write --cache --list-different --ignore-unknown",
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && yarn build:publint && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "type-fest": "^5.4.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./AllKeys": "./src/AllKeys.ts",
    "./Any": "./src/Any.ts",
    "./AnyAsyncFunction": "./src/AnyAsyncFunction.ts",
    "./AnyConstructor": "./src/AnyConstructor.ts",
    "./AnyFunction": "./src/AnyFunction.ts",
    "./AnyGetter": "./src/AnyGetter.ts",
    "./AnyPrototype": "./src/AnyPrototype.ts",
    "./AnySetter": "./src/AnySetter.ts",
    "./Assign": "./src/Assign.ts",
    "./CommonKeys": "./src/CommonKeys.ts",
    "./Comparator": "./src/Comparator.ts",
    "./Decrement": "./src/Decrement.ts",
    "./DeepArray": "./src/DeepArray.ts",
    "./DeepEquals": "./src/DeepEquals.ts",
    "./DeepObject": "./src/DeepObject.ts",
    "./EmptyObject": "./src/EmptyObject.ts",
    "./EmptyTuple": "./src/EmptyTuple.ts",
    "./EntryOf": "./src/EntryOf.ts",
    "./FunctionPrototype": "./src/FunctionPrototype.ts",
    "./GenericMap": "./src/GenericMap.ts",
    "./GetOptional": "./src/GetOptional.ts",
    "./GetRequired": "./src/GetRequired.ts",
    "./Increment": "./src/Increment.ts",
    "./IntersectMany": "./src/IntersectMany.ts",
    "./IsAsyncFunction": "./src/IsAsyncFunction.ts",
    "./JsonDefinedPrimitive": "./src/JsonDefinedPrimitive.ts",
    "./KeyOf": "./src/KeyOf.ts",
    "./Locale": "./src/Locale.ts",
    "./NamedFunction": "./src/NamedFunction.ts",
    "./NotUndefined": "./src/NotUndefined.ts",
    "./NumberKeyOf": "./src/NumberKeyOf.ts",
    "./ObjectEntry": "./src/ObjectEntry.ts",
    "./Optional": "./src/Optional.ts",
    "./OptionalKeys": "./src/OptionalKeys.ts",
    "./PackageJson": "./src/PackageJson.ts",
    "./ParametersFirstOptional": "./src/ParametersFirstOptional.ts",
    "./ParametersWithout": "./src/ParametersWithout.ts",
    "./PickOptional": "./src/PickOptional.ts",
    "./PickPrimitive": "./src/PickPrimitive.ts",
    "./PickRequired": "./src/PickRequired.ts",
    "./PredicateFn": "./src/PredicateFn.ts",
    "./Primitive": "./src/Primitive.ts",
    "./RemoveArgument": "./src/RemoveArgument.ts",
    "./RemoveArrayElement": "./src/RemoveArrayElement.ts",
    "./RemoveArrayElements": "./src/RemoveArrayElements.ts",
    "./RequiredKeys": "./src/RequiredKeys.ts",
    "./SetArrayElement": "./src/SetArrayElement.ts",
    "./StringKeyObject": "./src/StringKeyObject.ts",
    "./StringKeyOf": "./src/StringKeyOf.ts",
    "./StringValObject": "./src/StringValObject.ts",
    "./SymbolKeyOf": "./src/SymbolKeyOf.ts",
    "./TChar": "./src/TChar.ts",
    "./TDigit": "./src/TDigit.ts",
    "./TDigits": "./src/TDigits.ts",
    "./TFunction": "./src/TFunction.ts",
    "./TLengthOfString": "./src/TLengthOfString.ts",
    "./TNonEmptyString": "./src/TNonEmptyString.ts",
    "./TStringNotOfLength": "./src/TStringNotOfLength.ts",
    "./TStringOfLength": "./src/TStringOfLength.ts",
    "./TStringParser": "./src/TStringParser.ts",
    "./Tail": "./src/Tail.ts",
    "./ToMethod": "./src/ToMethod.ts",
    "./UnknownValueObject": "./src/UnknownValueObject.ts",
