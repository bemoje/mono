{
  "name": "@mono/table",
  "version": "2.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "description": "Table formatting and string processing utilities.",
  "keywords": [
    "table",
    "formatting",
    "string",
    "display",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "@mono/decorators": "workspace:^",
    "@mono/fs": "workspace:^",
    "@mono/number": "workspace:^",
    "@mono/string": "workspace:^",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./TableFormatter": "./src/TableFormatter.ts",
    "./formatAsStringTable": "./src/formatAsStringTable.ts",
    "./getHeadersFromCsvFile": "./src/getHeadersFromCsvFile.ts",
    "./iterateTableArrayAsObjects": "./src/iterateTableArrayAsObjects.ts",
    "./objectsToTable": "./src/objectsToTable.ts",
    "./parseCsvHeaderLine": "./src/parseCsvHeaderLine.ts"
  }
}
