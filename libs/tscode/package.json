{
  "name": "@mono/tscode",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "description": "TypeScript code processing utilities and AST helpers for imports, formatting, and linting.",
  "keywords": [
    "typescript",
    "ast",
    "imports",
    "formatting",
    "linting",
    "code-processing",
    "utilities"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs' && yarn build:publint",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "@mono/regex": "workspace:^",
    "@types/strip-comments": "^2.0.4",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "es-toolkit": "^1.45.1",
    "strip-comments": "2.0.1",
    "upath": "^2.0.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./importStatementGetKeywords": "./src/importStatementGetKeywords.ts",
    "./importStatementHasTypeKeyword": "./src/importStatementHasTypeKeyword.ts",
    "./importStatementStripKeywords": "./src/importStatementStripKeywords.ts",
    "./importStatementToFormattedOneLiner": "./src/importStatementToFormattedOneLiner.ts",
    "./importStatementToOneLiner": "./src/importStatementToOneLiner.ts",
    "./parseImportStatement": "./src/parseImportStatement.ts",
    "./tsCrlfToLf": "./src/tsCrlfToLf.ts",
    "./tsExtractImports": "./src/tsExtractImports.ts",
    "./tsLintFilepath": "./src/tsLintFilepath.ts",
    "./tsSortImports": "./src/tsSortImports.ts",
    "./tsStripImports": "./src/tsStripImports.ts"
  }
}
