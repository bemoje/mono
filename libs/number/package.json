{
  "name": "@mono/number",
  "version": "2.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "description": "Number formatting, rounding, and mathematical utilities.",
  "keywords": [
    "number",
    "formatting",
    "rounding",
    "math",
    "mathematical",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && yarn build:publint && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./NumberFormatter": "./src/NumberFormatter.ts",
    "./bytesToKilobytes": "./src/bytesToKilobytes.ts",
    "./bytesToMegabytes": "./src/bytesToMegabytes.ts",
    "./round": "./src/round.ts",
    "./roundDown": "./src/roundDown.ts",
    "./roundToNearest": "./src/roundToNearest.ts",
    "./roundUp": "./src/roundUp.ts",
    "./roundWith": "./src/roundWith.ts"
  }
}
