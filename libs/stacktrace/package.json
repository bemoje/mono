{
  "name": "@mono/stacktrace",
  "version": "1.1.3",
  "packageManager": "yarn@4.3.1",
  "module": "src/index.ts",
  "sideEffects": false,
  "type": "module",
  "description": "Beautiful, color-formatted stack trace output for Node.js errors with syntax-highlighted file paths and structured error properties.",
  "keywords": [
    "stacktrace",
    "stack-trace",
    "error",
    "formatting",
    "color",
    "syntax-highlighting",
    "node",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs' && yarn build:publint",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "stacktrace-parser": "^0.1.11",
    "upath": "^2.0.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./enablePrettyStackTrace": "./src/enablePrettyStackTrace.ts",
    "./prettyStackTrace": "./src/prettyStackTrace.ts"
  }
}
