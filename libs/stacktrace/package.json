{
  "name": "@mono/stacktrace",
  "version": "2.0.0",
  "packageManager": "yarn@4.3.1",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "type": "module",
  "description": "Beautiful, color-formatted stack trace output for Node.js errors with syntax-highlighted file paths and structured error properties.",
  "keywords": [
    "stacktrace",
    "stack-trace",
    "error",
    "formatting",
    "color",
    "syntax-highlighting",
    "node",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "stacktrace-parser": "^0.1.11",
    "upath": "^2.0.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./enablePrettyStackTrace": "./src/enablePrettyStackTrace.ts",
    "./prettyStackTrace": "./src/prettyStackTrace.ts"
  }
}
