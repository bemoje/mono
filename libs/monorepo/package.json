{
  "name": "@mono/monorepo",
  "version": "2.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "dependencies": {
    "depcheck": "^1.4.7",
    "es-toolkit": "^1.45.1",
    "fs-extra": "^11.3.4",
