    "./MonoRepo": "./src/MonoRepo.ts",
    "./AbstractCode": "./src/code/AbstractCode.ts",
    "./CodeBlock": "./src/code/CodeBlock.ts",
    "./TsCode": "./src/code/TsCode.ts",
    "./ImportKeywords": "./src/code/imports/ImportKeywords.ts",
