    "./getRootPackageJson": "./src/methods/getRootPackageJson.ts",
    "./getRootPackageJsonPath": "./src/methods/getRootPackageJsonPath.ts",
    "./Workspace": "./src/repo/Workspace.ts",
    "./SemanticExtnamePrefix": "./src/util/SemanticExtnamePrefix.ts",
