{
  "name": "@mono/profiler",
  "version": "2.2.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "description": "Performance profiling utilities for measuring execution time of functions, class methods, and modules.",
  "keywords": [
    "profiler",
    "performance",
    "profiling",
    "execution-time",
    "benchmarking",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "format-ws": "yarn prettier './*' 'src/**/*' --config '../../.prettierrc' --write --cache --list-different --ignore-unknown",
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && yarn build:publint && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "@mono/fn": "workspace:^",
    "@mono/object": "workspace:^",
    "@mono/table": "workspace:^",
    "@mono/types": "workspace:^",
    "prettier": "^3.3.3",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "es-toolkit": "^1.45.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Profiler": "./src/Profiler/Profiler.ts"
  }
}
