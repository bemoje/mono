{
  "name": "@mono/is",
  "version": "2.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "devDependencies": {
    "@mono/types": "workspace:^",
    "tsup": "^8.5.1"
  },
  "description": "Type checking and validation utilities with composable validators and detailed error reporting.",
  "keywords": [
    "is",
    "type-checking",
    "validation",
    "validators",
    "composable",
    "guards",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
