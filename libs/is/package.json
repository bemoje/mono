    "./ensureThat": "./src/ensureThat.ts",
    "./isArray": "./src/isArray.ts",
    "./isChar": "./src/isChar.ts",
    "./isClass": "./src/isClass.ts",
    "./isConstructor": "./src/isConstructor.ts",
    "./isDefined": "./src/isDefined.ts",
    "./isDigit": "./src/isDigit.ts",
