{
  "name": "@mono/regex",
  "version": "3.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "description": "Regular expression utilities for escaping special characters and performing detailed regex execution with match metadata.",
