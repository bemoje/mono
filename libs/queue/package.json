{
  "name": "@mono/queue",
  "version": "0.1.3",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsup": "^8.5.1"
  },
  "scripts": {
    "format-ws": "yarn prettier './*' 'src/**/*' --config '../../.prettierrc' --write --cache --list-different --ignore-unknown",
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "build:publint": "cd dist && npx --yes publint --level warning --pack npm",
    "npmPublish": "yarn build && yarn build:publint && cd dist && npm publish && cd ../../"
  },
  "keywords": [
    "queue",
    "async",
    "task",
    "dependency",
    "priority",
    "scheduling",
    "concurrency",
    "utilities",
    "typescript"
  ],
  "description": "Async task queue with dependency resolution, priority scheduling, and concurrency control.",
  "dependencies": {
    "p-queue": "^9.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./AsyncDependencyQueue": "./src/lib/AsyncDependencyQueue.ts",
    "./hasCircularDependencies": "./src/lib/hasCircularDependencies.ts",
    "./types": "./src/lib/types.ts"
  }
}
