{
  "name": "@mono/queue",
  "version": "1.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "cd dist && npm publish && cd ../../"
  },
  "keywords": [
    "queue",
    "async",
    "task",
    "dependency",
    "priority",
    "scheduling",
    "concurrency",
    "utilities",
    "typescript"
  ],
  "description": "Async task queue with dependency resolution, priority scheduling, and concurrency control.",
  "dependencies": {
    "p-queue": "^9.1.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./AsyncDependencyQueue": "./src/lib/AsyncDependencyQueue.ts",
    "./hasCircularDependencies": "./src/lib/hasCircularDependencies.ts",
    "./types": "./src/lib/types.ts"
  }
}
