{
  "name": "@mono/template",
  "version": "2.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "description": "A TypeScript template engine with schema validation and pluggable rendering strategies.",
  "keywords": [
    "template",
    "template-engine",
    "rendering",
    "schema",
    "validation",
    "typebox",
    "utilities",
    "typescript"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "@mono/tschema": "workspace:^",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Template": "./src/Template/Template.ts",
    "./TemplateStrategy": "./src/interfaces/TemplateStrategy.ts",
    "./JsonFileTemplateStrategy": "./src/strategies/JsonFileTemplateStrategy.ts",
    "./StringTemplateStrategy": "./src/strategies/StringTemplateStrategy.ts",
    "./TextFileTemplateStrategy": "./src/strategies/TextFileTemplateStrategy.ts"
  }
}
