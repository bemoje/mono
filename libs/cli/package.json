{
  "name": "@mono/cli",
  "version": "2.0.0",
  "description": "A type-safe CLI composer that can parse argv and generate help without execution coupling.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "indexts": "devkit clean index-ts",
    "build": "node esbuild.mjs"
  },
  "devDependencies": {
    "@bemoje/devkit": "0.1.0",
    "type-fest": "^5.4.4"
  },
  "keywords": [
    "cli",
    "command-line",
    "minimist",
    "typescript",
    "type-safe",
    "help-generation",
    "commander",
    "subcommands",
    "parsing",
    "composition",
    "terminal",
    "console",
    "args",
    "argv"
  ]
}
