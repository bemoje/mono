{
  "name": "@mono/cli",
  "version": "3.1.4",
  "description": "A type-safe CLI framework for building command-line interfaces with typed arguments, options, subcommands, and auto-generated help - without execution coupling.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "module": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "scope": "@bemoje"
  },
  "keywords": [
    "cli",
    "command-line",
    "minimist",
    "typescript",
    "type-safe",
    "help-generation",
    "commander",
    "subcommands",
    "parsing",
    "composition",
    "terminal",
    "console",
    "args",
    "argv"
  ],
  "scripts": {
    "build": "node '../../scripts/build-lib-bundle.mjs'",
    "npmPublish": "yarn build && cd dist && npm publish && cd ../../"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "es-toolkit": "^1.45.1"
  },
  "devDependencies": {
    "@mono/decorators": "workspace:^",
    "@mono/fn": "workspace:^",
    "@mono/node": "workspace:^",
    "@mono/object": "workspace:^",
    "tsup": "^8.5.1",
    "type-fest": "5.4.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/lib/helpers/index.ts",
    "./Command": "./src/lib/Command.ts",
    "./Help": "./src/lib/Help.ts",
    "./types": "./src/lib/types.ts"
  }
}
