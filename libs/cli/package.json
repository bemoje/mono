{
  "name": "@mono/cli",
  "version": "2.0.1",
  "description": "A type-safe CLI composer that can parse argv and generate help without execution coupling.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "sideEffects": false,
  "keywords": [
    "cli",
    "command-line",
    "minimist",
    "typescript",
    "type-safe",
    "help-generation",
    "commander",
    "subcommands",
    "parsing",
    "composition",
    "terminal",
    "console",
    "args",
    "argv"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "publish": "yarn build && cd dist && npm publish && cd ../../"
  },
  "devDependencies": {
    "type-fest": "^5.4.4"
  }
}
