{
  "name": "@mono/cli",
  "version": "1.0.5",
  "description": "A type-safe CLI builder focused on command composition and help generation without execution coupling. Parse arguments, generate help, and integrate with existing CLI frameworks through a clean, fluent API.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "indexts": "node ../../s/clean/indextsWs.mjs",
    "build": "node esbuild.mjs"
  },
  "devDependencies": {
    "commander": "^14.0.0"
  },
  "keywords": [
    "cli",
    "command-line",
    "argument-parser",
    "options-parser",
    "typescript",
    "type-safe",
    "fluent-api",
    "help-generation",
    "commander",
    "commander.js",
    "subcommands",
    "validation",
    "parsing",
    "composition",
    "adapter",
    "terminal",
    "console",
    "args",
    "argv"
  ]
}
