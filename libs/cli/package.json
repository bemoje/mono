{
  "name": "@mono/cli",
  "version": "1.1.1",
  "description": "A type-safe CLI composer that can parse argv and generate help without execution coupling.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "indexts": "node ../../s/clean/indextsWs.mjs",
    "build": "node esbuild.mjs"
  },
  "devDependencies": {
    "commander": "^14.0.0",
    "type-fest": "4.41.0"
  },
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "type-safe",
    "help-generation",
    "commander",
    "commander.js",
    "subcommands",
    "validation",
    "parsing",
    "composition",
    "terminal",
    "console",
    "args",
    "argv"
  ]
