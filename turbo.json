{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "yarn-install": {
      "outputs": ["node_modules/**", "yarn.lock"],
      "cache": false
    },
    "fix:fixOwnWsImports": {
      "inputs": ["libs/*/src/**/*.ts"],
      "outputs": [".next/**", "!.next/cache/**", "devkit.config.json"],
      "dependsOn": ["yarn-install"],
      "cache": true
    },
    "fix:indexts": {
      "inputs": [
        "libs/*/src/**/*.ts",
        "!libs/*/src/**/*.test.ts",
        "libs/*/package.json"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "devkit.config.json",
        "libs/*/src/index.ts",
        "libs/*/package.json"
      ],
      "dependsOn": ["yarn-install"],
      "cache": true
    },
    "fix:removeEmptyWsFiles": {
      "inputs": ["libs/*/src/**/*.ts", "!libs/*/src/**/*.test.ts"],
      "outputs": [".next/**", "!.next/cache/**", "devkit.config.json"],
      "dependsOn": ["yarn-install"],
      "cache": true
    },
    "fix:fixMissingDependencies": {
      "inputs": [
        "libs/*/src/**/*.ts",
        "apps/*/src/**/*.ts",
        "libs/*/package.json",
        "apps/*/package.json"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "devkit.config.json",
        "package.json",
        "libs/*/package.json",
        "apps/*/package.json",
        "yarn.lock"
      ],
      "dependsOn": ["yarn-install"],
      "cache": true
    },
    "fix:replaceBadDashChars": {
      "inputs": ["**/*.md"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "devkit.config.json",
        "**/*.md"
      ],
      "dependsOn": ["yarn-install"],
      "cache": true
    },
    "lint:fix": {
      "inputs": [
        "./*",
        "{libs,apps}/*/*",
        "{libs,apps}/*/src/**/*",
        "{scripts,notes,docs,.vscode,.github}/**/*"
      ],
      "dependsOn": [
        "yarn-install",
        "fix:fixOwnWsImports",
        "fix:indexts",
        "fix:fixMissingDependencies"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".eslintcache",
        "./*",
        "{libs,apps}/*/*",
        "{libs,apps}/*/src/**/*",
        "{scripts,notes,docs,.vscode,.github}/**/*"
      ],
      "cache": true
    },

    "format-all:write": {
      "inputs": [
        "./*",
        "{libs,apps}/*/*",
        "{libs,apps}/*/src/**/*",
        "{scripts,notes,docs,.vscode,.github}/**/*"
      ],
      "dependsOn": ["yarn-install", "lint:fix"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "./*",
        "{libs,apps}/*/*",
        "{libs,apps}/*/src/**/*",
        "{scripts,notes,docs,.vscode,.github}/**/*"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "libs/*/src/**/*.ts",
        "apps/*/src/**/*.ts",
        "*.json",
        "libs/*.json",
        "apps/*.json"
      ],
      "dependsOn": ["yarn-install", "lint:fix"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },
    "check:tsdoc": {
      "inputs": ["libs/*/src/**/*.ts", "apps/*/src/**/*.ts"],
      "dependsOn": ["yarn-install", "lint:fix"],
      "outputs": [".next/**", "!.next/cache/**", "devkit.config.json"],
      "cache": true
    },
    "check:knip": {
      "dependsOn": ["yarn-install", "lint:fix"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },

    "build": {
      "inputs": [
        "../../scripts/build-lib-bundle.mjs",
        "src/**/*",
        "./*.{json,mjs}",
        "../../*.{json,mjs}"
      ],
      "dependsOn": [
        "mono#yarn-install",
        "mono#lint:fix",
        "mono#format-all:write",
        "^build"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "cache": true
    },

    "test-coverage": {
      "inputs": ["libs/*/src/**/*.ts", "apps/*/src/**/*.ts"],
      "dependsOn": ["yarn-install", "build", "lint:fix", "format-all:write"],
      "outputs": [".next/**", "!.next/cache/**", ".coverage/**"],
      "cache": true
    },
    "test-coverage-full": {
      "inputs": [".coverage/json/coverage-final.json"],
      "dependsOn": ["test-coverage"],
      "outputs": [".next/**", "!.next/cache/**", "devkit.config.json"],
      "cache": true
    },

    "readme": {
      "inputs": [
        "{apps,libs}/*/dist/**/*.d.ts",
        "libs/*/package.json",
        "libs/*/README.md"
      ],
      "dependsOn": [
        "test-coverage",
        "fix:replaceBadDashChars",
        "format-all:write"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "devkit.config.json",
        "libs/*/README.md",
        "README.md"
      ],
      "cache": true
    },
    "runall": {
      "dependsOn": [
        "yarn-install",
        "fix:fixOwnWsImports",
        "fix:indexts",
        "fix:removeEmptyWsFiles",
        "fix:fixMissingDependencies",
        "fix:replaceBadDashChars",
        "lint:fix",
        "format-all:write",
        "typecheck",
        "check:tsdoc",
        "check:knip",
        "build",
        "test-coverage",
        "test-coverage-full",
        "readme"
      ]
    }
  },
  "remoteCache": { "signature": true },
  "ui": "stream-with-experimental-timestamps"
}
