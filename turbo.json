{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "precommit:write": { "cache": false },
    "typecheck": {
      "inputs": ["*.json", "{apps,libs}/*.json", "{apps,libs}/*/src/**/*.ts"],
      "dependsOn": ["precommit:write"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },
    "check:tsdoc": {
      "inputs": ["libs/*/src/**/*.ts"],
      "dependsOn": ["precommit:write"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },
    "check:knip": {
      "dependsOn": ["precommit:write"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": true
    },

    "build": {
      "inputs": [
        "../../scripts/build-lib-bundle.mjs",
        "src/**/*.ts",
        "*.{json,mjs}",
        "../../*.{json,mjs,lock}"
      ],
      "dependsOn": ["^build", "mono#precommit:write"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "cache": true
    },
    "test-coverage": {
      "inputs": ["libs/*/src/**/*.ts", "apps/*/src/**/*.ts"],
      "dependsOn": ["build", "precommit:write"],
      "outputs": [".next/**", "!.next/cache/**", ".coverage/**"],
      "cache": true
    },
    "test-coverage-full": {
      "inputs": [".coverage/json/coverage-final.json"],
      "dependsOn": ["test-coverage", "precommit:write"],
      "outputs": [".next/**", "!.next/cache/**", "devkit.config.json"],
      "cache": true
    },

    "readme": {
      "inputs": [
        "libs/*/src/**/*.ts",
        "libs/*/package.json",
        "libs/*/README.md",
        "docs/**/*"
      ],
      "dependsOn": ["test-coverage", "precommit:write"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "libs/*/README.md",
        "README.md"
      ],
      "cache": true
    },
    "runall": {
      "dependsOn": [
        "precommit:write",
        "typecheck",
        "check:knip",
        "check:tsdoc",
        "build",
        "test-coverage",
        "test-coverage-full",
        "readme"
      ],
      "cache": false
    }
  },
  "remoteCache": { "signature": true },
  "ui": "stream-with-experimental-timestamps"
}
