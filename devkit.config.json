{
  "templates": {
    "commands": {
      "openFileInIDE": "code {{filepath}}",
      "addDependency": "yarn add {{dependency}}",
      "addDevDependency": "yarn add {{dependency}} --D",
      "removeDependency": "yarn workspace {{workspace}} remove {{dependency}}"
    },
    "files": {
      "packageJson": {
        "name": "{{libraryName}}",
        "version": "0.0.1",
        "description": "",
        "keywords": [],
        "packageManager": "yarn@4.3.1",
        "type": "module",
        "private": true,
        "module": "src/index.ts",
        "sideEffects": false,
        "scripts": {
          "build": "node '../../scripts/build-lib-bundle.mjs'",
          "npmPublish": "yarn build && cd dist && npm publish && cd ../../"
        },
        "dependencies": {},
        "devDependencies": { "tsup": "^8.5.1" },
        "exports": { ".": "./src/index.ts" }
      },
      "tsup": [
        "import { defineConfig } from 'tsup'",
        "import { parseBarrelExportIndexFile } from '../../scripts/parseBarrelExportIndexFile.mjs'",
        "",
        "export default defineConfig({",
        "  entryPoints: parseBarrelExportIndexFile(),",
        "  bundle: false,",
        "  platform: 'node',",
        "  treeshake: 'recommended',",
        "  shims: true,",
        "  cjsInterop: true,",
        "  tsconfig: 'tsconfig.json',",
        "  target: 'esnext',",
        "  noExternal: ['type-fest', '@types/*', '@mono/*'],",
        "  format: ['esm', 'cjs'],",
        "  dts: 'src/index.ts',",
        "  dtsResolve: true,",
        "  outDir: 'dist/lib',",
        "  removeNodeProtocol: false,",
        "})",
        ""
      ],
      "readmeMd": ["# {{libraryName}}", ""],
      "tsconfigJson": { "extends": "../../tsconfig.json" },
      "indexTs": [""]
    }
  }
}
