{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "fix:indexts": { "dependsOn": ["fix:fixOwnWsImports"] },
    "fix:fixMissingDependencies": { "dependsOn": ["fix:indexts"] },
    "lint:staged": { "dependsOn": ["fix:fixMissingDependencies"] },

    "precommit:write": {
      "dependsOn": ["fix:indexts", "fix:fixMissingDependencies", "lint:staged"],
      "cache": false
    },
    "typecheck": { "dependsOn": ["precommit:write"] },
    "check:tsdoc": { "dependsOn": ["precommit:write"] },
    "check:knip": { "dependsOn": ["precommit:write"] },

    "test-coverage": {
      "dependsOn": ["precommit:write"],
      "outputs": [".coverage/**"]
    },
    "test-coverage-full": { "dependsOn": ["test-coverage", "precommit:write"] },
    "readme": { "dependsOn": ["test-coverage", "precommit:write"] },
    "build:all": {
      // "outputLogs": "hash-only",
      "cache": false,
      "dependsOn": ["mono#readme", "mono#precommit:write"]
    },
    "runall": {
      "dependsOn": [
        "precommit:write",
        "typecheck",
        "check:knip",
        "check:tsdoc",
        "test-coverage",
        "test-coverage-full",
        "readme",
        "build:all"
      ],
      "cache": false
    }
  },
  "remoteCache": { "signature": true },
  // "ui": "stream-with-experimental-timestamps"
  "ui": "tui"
}
