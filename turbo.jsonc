{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "fix": { "dependsOn": [] },
    "lint:fix": { "dependsOn": ["fix"] },
    "format:write:all": { "dependsOn": ["lint:fix"] },
    "precommit:fix": {
      "dependsOn": ["fix", "lint:fix", "format:write:all"],
      "cache": false
    },

    "typecheck": { "dependsOn": ["precommit:fix"] },
    "check:tsdoc": { "dependsOn": ["precommit:fix"] },
    "check:knip": { "dependsOn": ["precommit:fix"] },

    "test-coverage": {
      "dependsOn": ["precommit:fix"],
      "outputs": [".coverage/**"],
      "cache": false
    },
    "test-coverage-full": { "dependsOn": ["test-coverage"] },
    "build": {
      "cache": false,
      "dependsOn": ["^build", "mono#test-coverage"]
    },
    "precommit:check": {
      "dependsOn": [
        "precommit:fix",
        "typecheck",
        "check:knip",
        "check:tsdoc",
        "test-coverage",
        "test-coverage-full",
        "build"
      ],
      "cache": false
    },
    "readme": { "dependsOn": ["precommit:check"] },
    "precommit:all": {
      "dependsOn": ["precommit:fix", "precommit:check", "readme"],
      "cache": false
    }
  },
  "remoteCache": { "signature": true },
  "ui": "stream-with-experimental-timestamps"
  // "ui": "tui"
}
