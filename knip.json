{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {},
    "s": {
      "entry": [
        "**/*.mjs"
      ],
      "project": [
        "**/*.mjs"
      ]
    },
    "libs/*": {
      "ignoreDependencies": [
        "@mono/*"
      ],
      "entry": [
        "src/index.ts"
      ]
    },
    "apps/*": {
      "entry": [
        "src/main.ts"
      ],
      "ignoreDependencies": [
        "@mono/*"
      ]
    },
    "apps/playground": {
      "entry": [
        "**/*.ts"
      ],
      "ignoreDependencies": [
        "@mono/*"
      ]
    }
  }
}
