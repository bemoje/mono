{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    ".github/copilot/refactoring.mts"
  ],
  "includeEntryExports": false,
  "ignoreExportsUsedInFile": false,
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "nsExports",
    "nsTypes",
    "duplicates",
    "enumMembers",
    "classMembers",
    "catalog"
  ],
  "workspaces": {
    ".": {},
    "s": {
      "entry": [
        "**/*.mjs"
      ]
    },
    "libs/*": {
      "entry": [
        "src/index.ts"
      ]
    },
    "apps/*": {
      "entry": [
        "src/main.ts"
      ]
    },
    "apps/playground": {
      "entry": [
        "**/*.ts"
      ]
    }
  },
  "ignoreDependencies": [
    "@mono/*"
  ]
}
