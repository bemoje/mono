{
  "name": "mono",
  "description": "Private for-fun-only mono-repo with TypeScript utility libraries used by other private projects.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "fix": "yarn run-p --aggregate-output \"fix:*\"",
    "fix:fixOwnWsImports": "yarn dk fix-workspace-imports",
    "fix:indexts": "yarn dk fix-index-ts",
    "fix:removeEmptyWsFiles": "yarn dk fix-empty-files",
    "fix:replaceBadDashChars": "yarn dk fix-dash-chars",
    "check": "yarn run-s -n \"check:*\"",
    "check:knip": "yarn knip --config knip.jsonc --cache --no-config-hints",
    "check:tsdoc": "yarn dk missing-tsdoc-files",
    "build": "yarn wsp '*/*' run build",
    "build:apps": "yarn wsp 'apps/*' run build",
    "build:libs": "yarn wsp 'libs/*' run build",
    "insight": "yarn run-s -n \"insight:*\"",
    "readme": "yarn dk build-readme",
    "lint": "yarn eslint --fix",
    "lint:fix": "yarn eslint --fix --cache 'scripts/**/*.ts' '{libs,apps}/*/src/**/*.ts'",
    "lint:check": "yarn eslint --cache 'scripts/**/*.ts' '{libs,apps}/*/src/**/*.ts'",
    "format-all:check": "yarn format:check --cache '**/*.{ts,js,mjs,md,json}'",
    "format-all:write": "yarn format:write --cache '**/*.{ts,js,mjs,md,json}'",
    "format:write": "yarn format --write --list-different",
    "format:check": "yarn format --check",
    "format": "yarn prettier --ignore-unknown",
    "typecheck": "yarn tsc -p tsconfig.json --noEmit",
    "test": "yarn vitest --run",
    "test:watch": "yarn vitest",
    "test-coverage": "yarn vitest --run --coverage --cache",
    "test-coverage-full": "yarn dk missing-coverage-files --check",
    "test-coverage:open": ".coverage/html/index.html",
    "precommit": "yarn install && yarn run-s -n fix lint:fix format-all:write typecheck check build test-coverage test-coverage-full readme && echo 'Passed!'",
    "publish:devkit": "yarn workspace devkit run build && cd apps/devkit/dist && npm publish && cd ../../../",
    "publish:linkedin-resume": "yarn workspace linkedin-resume run build && cd apps/linkedin-resume && npm publish && cd ../../",
    "publish-libs": "node scripts/publish-libs.mjs",
    "wsp": "yarn workspaces foreach --parallel --all --topological --exclude mono --verbose --include",
    "wss": "yarn workspaces foreach --all --topological --exclude mono --verbose --include",
    "ws": "node scripts/ws.mjs",
    "ts": "yarn tsx --import 'tsconfig-paths/register' --import 'scripts/enablePrettyStackTrace.ts' --import 'dotenv/config'",
    "dk": "yarn tsx --import 'tsconfig-paths/register' --import 'scripts/enablePrettyStackTrace.ts' --import 'dotenv/config' apps/devkit/src/main.ts",
    "script:npmEnsureLoggedIn": "node scripts/npmEnsureLoggedIn.mjs"
  },
  "optionalDependencies": {
    "@clack/core": "^1.1.0",
    "@clack/prompts": "^1.1.0"
  },
  "devDependencies": {
    "@bemoje/devkit": "3.2.0",
    "@bemoje/eslint": "1.0.1",
    "@eslint/js": "^10.0.1",
    "@sngn/eslint-plugin-split-and-sort-imports": "^0.4.3",
    "@swc/core": "^1.15.17",
    "@types/cli-table": "^0.3.4",
    "@types/command-exists": "^1.2.3",
    "@types/date-fns": "^2.6.3",
    "@types/execa": "^2.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/humanize-duration": "^3.27.4",
    "@types/memoizee": "^0.4.12",
    "@types/strip-comments": "^2.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "depcheck": "1.4.7",
    "esbuild": "^0.23.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^9.6.1",
    "globals": "^17.3.0",
    "knip": "^5.83.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "tsconfig-paths": "^4.2.0",
    "tsd": "^0.31.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.37",
    "@types/node": "^24.3.1",
    "ansi-colors": "^4.1.3",
    "cli-table": "^0.3.11",
    "command-exists": "^1.2.9",
    "commander": "^14.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "enhanced-ms": "^4.1.0",
    "enquirer": "^2.4.1",
    "es-toolkit": "^1.44.0",
    "fs-extra": "^11.3.4",
    "glob": "^11.0.0",
    "humanize-duration": "^3.33.2",
    "inquirer-checkbox-plus-plus": "^1.1.1",
    "iter-tools": "^7.5.4",
    "memoizee": "^0.4.17",
    "mnemonist": "^0.40.3",
    "onetime": "^7.0.0",
    "puppeteer": "^24.37.4",
    "source-map-support": "^0.5.21",
    "stacktrace-parser": "^0.1.11",
    "string-argv": "^0.3.2",
    "strip-comments": "2.0.1",
    "type-fest": "5.4.4",
    "upath": "^2.0.1",
    "walkdir": "^0.4.1"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Møller Jensen",
    "email": "bemoje@bemoje.net",
    "url": "https://github.com/bemoje/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bemoje/mono.git"
  },
  "homepage": "https://github.com/bemoje/mono"
}
