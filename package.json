{
  "name": "mono",
  "description": "Private for-fun-only mono-repo with TypeScript utility libraries used by other private projects.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "r": "node s/run.mjs",
    "clean": "echo '\nCLEAN...' && yarn clean:fixOwnWsImports && yarn clean:indexts && yarn clean:ensureVitestImports && yarn clean:removeEmptyWsFiles",
    "clean:fixOwnWsImports": "echo 'fixOwnWsImports...' && node .dist/devkit.cjs deps fix -f imports -y",
    "clean:indexts": "yarn workspaces foreach -Apt --verbose run indexts",
    "clean:ensureVitestImports": "node s/clean/ensureVitestImports.mjs",
    "clean:removeEmptyWsFiles": "node s/clean/removeEmptyWsFiles.mjs",
    "build": "echo '\nBUILD...' && yarn workspaces foreach -Apt --verbose --exclude mono run build",
    "insight": "echo '\nINSIGHT...' && yarn insight:depcheckUnused && yarn insight:checkLibsTsDoc && yarn insight:linesOfCode",
    "insight:depcheckUnused": "node s/insight/depcheckUnused.mjs",
    "insight:checkLibsTsDoc": "node s/insight/checkLibsTsDoc.mjs",
    "insight:linesOfCode": "node s/insight/linesOfCode.mjs",
    "docs": "echo '\nDOCS...' && node s/docs/writeReadme.mjs",
    "lint": "echo '\nLINT...' && yarn eslint '{libs,apps,s}/**/*' --fix -c eslint.config.js --cache --ignore-pattern apps/playground",
    "format": "echo '\nFORMAT...' && yarn prettier -w --l -u '{.github,.vscode,s,docs,apps,libs}/**/*'",
    "typecheck": "echo '\nTYPECHECK...' && yarn tsc -p tsconfig.json --noEmit",
    "test": "yarn vitest --config 'vitest.config.js' --run",
    "test:watch": "yarn vitest --config 'vitest.config.js'",
    "test-coverage": "echo '\nTEST-COVERAGE...' && yarn vitest --config 'vitest.config.js' --run --coverage",
    "test-coverage:open": ".coverage/html/index.html",
    "precommit": "cls && echo '\nPRECOMMIT...' && yarn install && yarn clean && yarn typecheck && yarn lint && yarn test-coverage && yarn build && yarn docs && yarn format && yarn insight",
    "dk": "yarn workspace devkit build && node .dist/devkit.cjs",
    "DK": "node .dist/devkit.cjs",
    "ws": "node s/wsRun.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@microsoft/tsdoc": "^0.15.1",
    "@types/cli-table": "^0.3.4",
    "@types/command-exists": "^1.2.3",
    "@types/date-fns": "^2.6.3",
    "@types/depcheck": "^0.9.4",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.20",
    "@types/lodash-es": "^4.17.12",
    "@types/memoizee": "^0",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.14",
    "@types/reflect-metadata": "^0.1.0",
    "@types/shuffle-array": "^1.0.5",
    "@types/source-map-support": "^0.5.10",
    "@types/strip-comments": "^2.0.4",
    "@types/validator": "^13",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "corepack": "^0.29.3",
    "depcheck": "1.4.7",
    "esbuild": "^0.23.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.8.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsd": "^0.31.2",
    "typescript": "5.5.4",
    "typescript-eslint": "^7.17.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.37",
    "ansi-colors": "^4.1.3",
    "cli-table": "^0.3.11",
    "command-exists": "^1.2.9",
    "commander": "^14.0.0",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "enhanced-ms": "^4.1.0",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.0",
    "iter-tools": "^7.5.4",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "memoizee": "^0.4.17",
    "mnemonist": "^0.40.3",
    "ms": "^2.1.3",
    "onetime": "^7.0.0",
    "p-queue": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "source-map-support": "^0.5.21",
    "stacktrace-parser": "^0.1.11",
    "strip-comments": "2.0.1",
    "type-fest": "4.41.0",
    "upath": "^2.0.1",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "walkdir": "^0.4.1",
    "zustand": "^5.0.7"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Møller Jensen",
    "email": "bemoje@bemoje.net",
    "url": "https://github.com/bemoje/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bemoje/mono.git"
  },
  "homepage": "https://github.com/bemoje/tsmono"
}
