{
  "name": "mono",
  "description": "TypeScript utility libraries monorepo. Libraries are published to npm under the @bemoje scope.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*",
    ".",
    "scripts"
  ],
  "scripts": {
    "fix": "yarn run-s \"fix:*\"",
    "fix:indexts": "yarn DK fix-index-ts",
    "fix:fixMissingDependencies": "yarn DK fix-missing-dependencies -y",
    "fix:replaceBadDashChars": "yarn DK fix-dash-chars",
    "fix:removeEmptyWsFiles": "yarn DK fix-empty-files",
    "check": "yarn run-s -n \"check:*\"",
    "check:knip": "yarn knip --config knip.jsonc --cache --no-config-hints",
    "check:tsdoc": "yarn dk missing-tsdoc-files",
    "build:all": "yarn wsp '*/*' run build",
    "build:apps": "yarn wsp 'apps/*' run build",
    "build:libs": "yarn wsp 'libs/*' run build",
    "insight": "yarn run-s -n \"insight:*\"",
    "readme": "yarn dk build-readme",
    "lint": "yarn eslint --fix",
    "lint:fix": "yarn eslint --fix --cache '*.{js,mjs}' '{libs,apps}/*/*.{js,mjs}' '{libs,apps}/*/src/**/*.ts' '{scripts,notes,docs,.vscode,.github}/**/*.{js,mjs,ts}'",
    "lint:check": "yarn eslint '*.{js,mjs}' '{libs,apps}/*/*.{js,mjs}' '{libs,apps}/*/src/**/*.ts' '{scripts,notes,docs,.vscode,.github}/**/*.{js,mjs,ts}'",
    "format:check:all": "yarn format:check '*.{js,mjs,json,jsonc,md,yml}' '{libs,apps}/*/*.{js,mjs,json,jsonc,md,yml}' '{libs,apps}/*/src/**/*.ts' '{scripts,notes,docs,.vscode,.github}/**/*.{js,mjs,json,jsonc,md,yml}'",
    "format:write:all": "yarn format:write --cache '*.{js,mjs,json,jsonc,md,yml}' '{libs,apps}/*/*.{js,mjs,json,jsonc,md,yml}' '{libs,apps}/*/src/**/*.ts' '{scripts,notes,docs,.vscode,.github}/**/*.{js,mjs,json,jsonc,md,yml}'",
    "format:write": "yarn prettier --ignore-unknown --write --list-different",
    "format:check": "yarn prettier --ignore-unknown --check",
    "lint:staged": "yarn lint-staged --config lint-staged.config.js",
    "typecheck": "yarn tsc -p tsconfig.json --noEmit",
    "test": "yarn vitest --run",
    "test:watch": "yarn vitest",
    "test-coverage": "node ./scripts/test-coverage.mjs",
    "test-coverage-full": "yarn dk missing-coverage-files --check",
    "test-coverage:open": ".coverage/html/index.html",
    "precommit:all": "echo 'All tasks completed'",
    "precommit": "yarn install && yarn turbo run precommit:all",
    "precommit:fix": "echo 'Fixes applied'",
    "precommit:check": "echo 'Checks passed'",
    "publish:pkg-runner": "yarn workspace pkg-runner run build && cd apps/pkg-runner/dist && npm publish && cd ../../../",
    "publish:devkit": "yarn workspace devkit run build && cd apps/devkit/dist && npm publish && cd ../../../",
    "publish:linkedin-resume": "yarn workspace linkedin-resume run build && cd apps/linkedin-resume && npm publish && cd ../../",
    "publish-all": "node scripts/publish-all.mjs",
    "wsp": "yarn workspaces foreach --parallel --all --jobs 10 --topological --exclude mono --verbose --include",
    "wss": "yarn workspaces foreach --all --topological --exclude mono --verbose --include",
    "ws": "node scripts/ws.mjs",
    "ts": "yarn tsx --import 'tsconfig-paths/register' --import './scripts/enablePrettyStackTrace.ts' --import 'dotenv/config'",
    "dk": "yarn tsx --import 'tsconfig-paths/register' --import './scripts/enablePrettyStackTrace.ts' --import 'dotenv/config' apps/devkit/src/main.ts",
    "DK": "yarn devkit",
    "script:npmEnsureLoggedIn": "node ./scripts/npmEnsureLoggedIn.mjs",
    "createWorkspaceHash": "yarn tsx ./scripts/createWorkspaceHash.ts",
    "prepare": "husky",
    "release": "yarn build:all && yarn publish-all"
  },
  "devDependencies": {
    "@bemoje/devkit": "^5.0.1",
    "@bemoje/eslint": "^2.0.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@mono/monorepo": "workspace:^",
    "@sngn/eslint-plugin-split-and-sort-imports": "^0.4.3",
    "@swc/core": "^1.15.17",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv": "^17.3.1",
    "esbuild": "^0.23.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^11.1.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "lint-staged": "^16.3.3",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "tsconfig-paths": "^4.2.0",
    "tsd": "^0.31.2",
    "tsx": "^4.21.0",
    "turbo": "^2.8.16",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.56.1",
    "upath": "^2.0.1",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Møller Jensen",
    "email": "bemoje@bemoje.net",
    "url": "https://github.com/bemoje/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bemoje/mono.git"
  },
  "homepage": "https://github.com/bemoje/mono"
}
