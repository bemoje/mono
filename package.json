{
  "name": "mono",
  "description": "Private for-fun-only mono-repo with TypeScript utility libraries used by other private projects.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "r": "devkit run",
    "clean": "yarn run-p --aggregate-output -n \"clean:*\"",
    "clean:fixOwnWsImports": "devkit fix-workspace-imports",
    "clean:indexts": "devkit fix-index-ts --ignore 'path'",
    "clean:removeEmptyWsFiles": "devkit fix-empty-files",
    "clean:replaceBadDashChars": "devkit fix-dash-chars",
    "check": "yarn run-p --aggregate-output -n \"check:*\"",
    "check:tsdoc": "devkit missing-tsdoc-files",
    "check:knip": "knip --config knip.jsonc --cache --no-config-hints",
    "build": "yarn build:libs && yarn build:apps",
    "build:apps": "yarn foreach --include 'apps/**' run build",
    "build:libs": "devkit build-libs",
    "insight": "yarn run-s -n \"insight:*\"",
    "docs": "devkit build-readme",
    "lint": "yarn eslint --config eslint.config.mjs --cache --ignore-pattern apps/playground --ignore-pattern '**/dist/**'",
    "lint-fix-imports": "yarn lint --fix && yarn lint --fix --rule 'split-and-sort-imports/split-imports: warn' --rule 'unused-imports/no-unused-imports: off'",
    "lint-fix": "yarn lint --fix '{libs,apps}/**/*'",
    "format-all:check": "yarn prettier -u ./ '{.github,.vscode,scripts,docs,apps,libs}/**/*' --check",
    "format:write": "node scripts/format.mjs --write --ignore-unknown --list-different",
    "format:check": "node scripts/format.mjs --check --ignore-unknown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "yarn vitest --run",
    "test:watch": "yarn vitest",
    "test-coverage": "yarn vitest --run --coverage --bail 1",
    "test-coverage-full": "devkit missing-coverage-files --check",
    "test-coverage:open": ".coverage/html/index.html",
    "precommit:fix": "yarn run-s -n clean lint-fix format:write",
    "precommit:check": "yarn run-p --aggregate-output -n typecheck check",
    "precommit:docs": "yarn run-s -n test-coverage-full docs",
    "precommit": "cls && yarn install && yarn precommit:fix && yarn test-coverage && yarn build && yarn precommit:check && yarn precommit:docs",
    "publish:devkit": "yarn workspace @bemoje/devkit run build && cd apps/devkit && npm publish && cd ../../",
    "publish:linkedin-resume": "yarn workspace linkedin-resume run build && cd apps/linkedin-resume && npm publish && cd ../../",
    "publish:array": "yarn workspace @mono/array run build && cd libs/array/dist && npm publish && cd ../../../",
    "publish:cli": "yarn workspace @mono/cli run build && cd libs/cli/dist && npm publish && cd ../../../",
    "foreach": "yarn workspaces foreach --all --parallel --jobs unlimited --exclude mono --verbose",
    "devkit": "node -r source-map-support/register apps/devkit/dist/devkit.cjs",
    "dk": "yarn workspace @bemoje/devkit run build && yarn devkit",
    "lol": "devkit"
  },
  "devDependencies": {
    "@bemoje/devkit": "workspace:^",
    "@eslint/js": "^9.8.0",
    "@sngn/eslint-plugin-split-and-sort-imports": "^0.4.3",
    "@types/cli-table": "^0.3.4",
    "@types/command-exists": "^1.2.3",
    "@types/date-fns": "^2.6.3",
    "@types/fs-extra": "^11.0.4",
    "@types/humanize-duration": "^3",
    "@types/memoizee": "^0.4.12",
    "@types/source-map-support": "^0.5.10",
    "@types/strip-comments": "^2.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "depcheck": "1.4.7",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unused-imports": "4",
    "globals": "^15.8.0",
    "knip": "^5.83.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "tsconfig-paths": "^4.2.0",
    "tsd": "^0.31.2",
    "type-fest": "^5.4.4",
    "typescript": "5.5.4",
    "typescript-eslint": "^7.17.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@bemoje/cli": "2.0.1",
    "@sinclair/typebox": "^0.34.37",
    "@types/node": "^24.3.1",
    "ansi-colors": "^4.1.3",
    "cli-table": "^0.3.11",
    "command-exists": "^1.2.9",
    "commander": "^14.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "enhanced-ms": "^4.1.0",
    "es-toolkit": "^1.44.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.0",
    "humanize-duration": "^3.33.2",
    "iter-tools": "^7.5.4",
    "memoizee": "^0.4.17",
    "mnemonist": "^0.40.3",
    "onetime": "^7.0.0",
    "p-queue": "^8.1.0",
    "puppeteer": "^24.37.4",
    "source-map-support": "^0.5.21",
    "stacktrace-parser": "^0.1.11",
    "strip-comments": "2.0.1",
    "upath": "^2.0.1",
    "walkdir": "^0.4.1"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Møller Jensen",
    "email": "bemoje@bemoje.net",
    "url": "https://github.com/bemoje/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bemoje/mono.git"
  },
  "homepage": "https://github.com/bemoje/mono"
}
