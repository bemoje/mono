{
  "name": "mono",
  "description": "Private for-fun-only mono-repo with TypeScript utility libraries used by other private projects.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "r": "node .dist/devkit.cjs run",
    "clean": "echo '\nCLEAN...' && yarn clean:fixOwnWsImports && yarn clean:indexts && yarn clean:ensureVitestImports && yarn clean:removeEmptyWsFiles && yarn clean:replaceBadDashChars",
    "clean:fixOwnWsImports": "echo 'fixOwnWsImports...' && node .dist/devkit.cjs deps fix -f imports -y",
    "clean:indexts": "yarn workspaces foreach -Apt --verbose run indexts",
    "clean:ensureVitestImports": "node .dist/devkit.cjs clean vitest-imports",
    "clean:removeEmptyWsFiles": "node .dist/devkit.cjs clean empty-files",
    "build": "echo '\nBUILD...' && yarn workspaces foreach -Apt --verbose --exclude mono run build",
    "clean:replaceBadDashChars": "node .dist/devkit.cjs clean dash-chars",
    "insight": "echo '\nINSIGHT...' && yarn insight:knip && yarn insight:checkLibsTsDoc && yarn insight:filesWithMissingCoverage && yarn insight:linesOfCode",
    "insight:checkLibsTsDoc": "node .dist/devkit.cjs insight tsdoc",
    "insight:filesWithMissingCoverage": "echo 'Files with incomplete code coverage:' && node .dist/devkit.cjs insight coverage --check",
    "insight:knip": "knip --config knip.jsonc --cache --no-config-hints",
    "insight:linesOfCode": "node .dist/devkit.cjs insight loc",
    "docs": "echo '\nDOCS...' && node .dist/devkit.cjs docs readme",
    "lint": "echo '\nLINT...' && eslint '{libs,apps}/**/*' --fix -c eslint.config.js --cache --ignore-pattern apps/playground --ignore-pattern '**/dist/**'",
    "format": "echo '\nFORMAT...' && prettier -w --l -u '{.github,.vscode,s,docs,apps,libs}/**/*'",
    "typecheck": "echo '\nTYPECHECK...' && tsc -p tsconfig.json --noEmit",
    "test": "vitest --config 'vitest.config.js' --run",
    "test:watch": "vitest --config 'vitest.config.js'",
    "test-coverage": "echo '\nTEST-COVERAGE...' && vitest --config 'vitest.config.js' --run --coverage",
    "test-coverage:open": ".coverage/html/index.html",
    "precommit": "echo '\nPRECOMMIT...' && yarn install && yarn clean && yarn typecheck && yarn lint && yarn build && yarn test-coverage && yarn insight && yarn docs && yarn format",
    "dk": "yarn workspace @bemoje/devkit build && node .dist/devkit.cjs",
    "DK": "node .dist/devkit.cjs",
    "ws": "node .dist/devkit.cjs ws",
    "publish:devkit": "yarn workspace @bemoje/devkit build && yarn workspace @bemoje/devkit npm publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/cli-table": "^0.3.4",
    "@types/command-exists": "^1.2.3",
    "@types/date-fns": "^2.6.3",
    "@types/fs-extra": "^11.0.4",
    "@types/memoizee": "^0",
    "@types/source-map-support": "^0.5.10",
    "@types/strip-comments": "^2.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "depcheck": "1.4.7",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.8.0",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "prettier": "^3.3.3",
    "tsd": "^0.31.2",
    "type-fest": "^5.4.4",
    "typescript": "5.5.4",
    "typescript-eslint": "^7.17.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.37",
    "@types/node": "^24.3.1",
    "ansi-colors": "^4.1.3",
    "cli-table": "^0.3.11",
    "command-exists": "^1.2.9",
    "commander": "^14.0.0",
    "date-fns": "^4.1.0",
    "enhanced-ms": "^4.1.0",
    "es-toolkit": "^1.44.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.0",
    "iter-tools": "^7.5.4",
    "memoizee": "^0.4.17",
    "mnemonist": "^0.40.3",
    "onetime": "^7.0.0",
    "p-queue": "^8.1.0",
    "source-map-support": "^0.5.21",
    "stacktrace-parser": "^0.1.11",
    "strip-comments": "2.0.1",
    "upath": "^2.0.1",
    "walkdir": "^0.4.1"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Møller Jensen",
    "email": "bemoje@bemoje.net",
    "url": "https://github.com/bemoje/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bemoje/mono.git"
  },
  "homepage": "https://github.com/bemoje/mono"
}
