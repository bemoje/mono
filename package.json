{
  "name": "mono",
  "description": "Private for-fun-only mono-repo with TypeScript utility libraries used by other private projects.",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "r": "yarn DK run",
    "clean": "yarn run-parallel \"clean:*\"",
    "clean:indexts": "yarn foreach --parallel run indexts",
    "clean:removeEmptyWsFiles": "yarn DK clean empty-files",
    "clean:replaceBadDashChars": "yarn DK clean dash-chars",
    "fix": "yarn run-parallel \"fix:*\"",
    "fix:fixOwnWsImports": "yarn DK deps fix --fixes imports",
    "check": "yarn run-parallel \"check:*\"",
    "check:knip": "knip --config knip.jsonc --cache --no-config-hints",
    "check:tsdoc": "yarn DK insight tsdoc",
    "check:filesWithMissingCoverage": "yarn DK insight coverage --check",
    "build": "yarn rimraf .dist && yarn foreach run build",
    "rebuild": "yarn foreach --parallel run build",
    "insight": "yarn insight:filesWithMissingCoverage && yarn insight:linesOfCode",
    "insight:linesOfCode": "yarn DK insight loc",
    "docs": "yarn DK docs readme",
    "lint": "yarn eslint '{libs,apps}/**/*' --fix -c eslint.config.js --cache --ignore-pattern apps/playground --ignore-pattern '**/dist/**'",
    "format:all": "yarn prettier -w --l -u '{.github,.vscode,s,docs,apps,libs}/**/*'",
    "format:write": "node scripts/format.mjs --write --ignore-unknown --list-different",
    "format:check": "node scripts/format.mjs --check --ignore-unknown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --config 'vitest.config.js' --run",
    "test:watch": "vitest --config 'vitest.config.js'",
    "test-coverage": "vitest --config 'vitest.config.js' --run --coverage",
    "test-coverage:open": ".coverage/html/index.html",
    "precommit": "cls && yarn install && yarn run-sequence build fix clean typecheck lint format:write rebuild test-coverage check docs",
    "dk": "yarn build:devkit && yarn DK",
    "DK": "node .dist/devkit.cjs",
    "publish:devkit": "yarn workspace @bemoje/devkit build && yarn workspace @bemoje/devkit npm publish",
    "build:devkit": "yarn workspace @bemoje/devkit build",
    "foreach": "yarn workspaces foreach --all --topological --verbose --exclude mono",
    "prepare": "yarn husky",
    "run-parallel": "yarn run-p -n -l",
    "run-sequence": "yarn run-s -n"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/cli-table": "^0.3.4",
    "@types/command-exists": "^1.2.3",
    "@types/date-fns": "^2.6.3",
    "@types/fs-extra": "^11.0.4",
    "@types/memoizee": "^0",
    "@types/rimraf": "^4.0.5",
    "@types/source-map-support": "^0.5.10",
    "@types/strip-comments": "^2.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "depcheck": "1.4.7",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.8.0",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "tsd": "^0.31.2",
    "type-fest": "^5.4.4",
    "typescript": "5.5.4",
    "typescript-eslint": "^7.17.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.37",
    "@types/node": "^24.3.1",
    "ansi-colors": "^4.1.3",
    "cli-table": "^0.3.11",
    "command-exists": "^1.2.9",
    "commander": "^14.0.0",
    "date-fns": "^4.1.0",
    "enhanced-ms": "^4.1.0",
    "es-toolkit": "^1.44.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.0",
    "iter-tools": "^7.5.4",
    "memoizee": "^0.4.17",
    "mnemonist": "^0.40.3",
    "onetime": "^7.0.0",
    "p-queue": "^8.1.0",
    "source-map-support": "^0.5.21",
    "stacktrace-parser": "^0.1.11",
    "strip-comments": "2.0.1",
    "upath": "^2.0.1",
    "walkdir": "^0.4.1"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Møller Jensen",
    "email": "bemoje@bemoje.net",
    "url": "https://github.com/bemoje/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bemoje/mono.git"
  },
  "homepage": "https://github.com/bemoje/mono"
}
