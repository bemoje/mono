{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  "includeEntryExports": true,
  // "ignoreExportsUsedInFile": true,

  "ignore": [".github/copilot/refactoring.mts"],

  "workspaces": {
    ".": {},

    "s": {
      "entry": ["**/*.mjs"],
    },

    "apps/*": {
      "entry": ["src/main.ts", "**/*.examples.ts"],
    },
    "apps/playground": {
      "entry": ["**/*.ts"],
    },

    "libs/*": {
      "entry": ["src/index.ts", "src/**/*.examples.ts"],
      "includeEntryExports": false,
    },
    "libs/composition": {
      "entry": ["src/index.ts", "src/**/*.examples.ts"],
      "includeEntryExports": false,
      "ignoreMembers": ["depth"],
    },
  },

  "include": ["nsTypes", "nsExports", "classMembers"],

  "rules": {
    "nsTypes": "warn",
    "nsExports": "warn",
    "classMembers": "warn",
    // "files": "error",
    // "dependencies": "error",
    // "devDependencies": "error",
    // "optionalPeerDependencies": "error",
    // "unlisted": "error",
    // "binaries": "error",
    // "unresolved": "error",
    // "exports": "error",
    // "types": "error",
    // "duplicates": "error",
    // "enumMembers": "error",
    // "catalog": "error",
  },
}
