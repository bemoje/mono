{
  "include": ["nsTypes", "nsExports"],

  "ignoreExportsUsedInFile": true,
  "ignoreFiles": [
    "scripts/parseBarrelExportIndexFile.mjs" //
  ],
  "ignore": [
    ".github/copilot/refactoring.mts",
    "libs/prompt/examples/**/*", //
    "apps/playground/src/**/*"
  ],
  "ignoreDependencies": [
    "tsconfig-paths", //
    "@swc/core"
    // "@mono/*"
  ],

  "ignoreBinaries": [
    "apps/devkit/src/main.ts" //
  ],

  "workspaces": {
    "apps/*": {
      "entry": [
        "src/*.ts", //
        "**/*.examples.ts",
        "src/**/*.examples.ts"
      ],
      "includeEntryExports": true
    },
    "libs/*": {
      "entry": [
        "src/index.ts", //
        "**/*.examples.ts",
        "src/**/*.examples.ts"
      ],
      "includeEntryExports": false
    }
  },

  "rules": {
    "nsTypes": "error",
    "nsExports": "error",

    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "catalog": "error"
  }
}
