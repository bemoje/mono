{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // "includeEntryExports": true,
  // "ignoreExportsUsedInFile": true,

  "ignore": [".github/copilot/refactoring.mts"],
  "ignoreDependencies": ["@mono/*"],

  "workspaces": {
    ".": {},

    "s": {
      "entry": ["**/*.mjs"],
    },

    "apps/*": {
      "includeEntryExports": true,
    },
    "apps/playground": {
      "entry": ["**/*.ts"],
      "includeEntryExports": true,
    },

    "libs/*": {},
    "libs/{array,crypto,date,fs,iter,os,regex,stacktrace,string,terminal,tschema,types}": {
      "ignoreDependencies": [],
    },
    "libs/composition": {
      "ignoreMembers": ["depth"],
    },
  },

  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "nsExports",
    "nsTypes",
    "duplicates",
    "enumMembers",
    "classMembers",
    "catalog",
  ],
}
